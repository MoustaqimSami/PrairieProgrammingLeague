# Copy this file to .env and fill in your own values. .env is ignored by Git.

# Where Postgres lives: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:dev@localhost:5432/prairie_league

# Port the Express API listens on
PORT=3001

# Optional. Kattis asks automated tools to identify themselves and say how to reach the
# operator. The scraper already sends a name and the site's contact link; set this only
# to change it.
# SCRAPER_USER_AGENT=PrairieProgrammingLeagueBot/1.0 (+https://prairieprogrammingleague.com/links#contact)

# Optional: the attendance Google Sheet (see docs/DEPLOY.md, "Connecting the attendance sheet").
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
