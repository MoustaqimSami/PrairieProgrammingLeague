# Copy this file to .env and fill in your own values. .env is ignored by Git.

# Where Postgres lives: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:dev@localhost:5432/prairie_league

# Port the Express API listens on
PORT=3001

# Kattis asks automated tools to identify themselves and say how to reach the operator.
# Put the league's website and a contact email here before scraping.
SCRAPER_USER_AGENT=PrairieLeagueBot/1.0 (+https://example.com; league@example.com)
